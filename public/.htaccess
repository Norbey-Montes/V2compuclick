RewriteEngine On

    # 2. Si la petición NO es un archivo existente (!-f)
    RewriteCond %{REQUEST_FILENAME} !-f

    # 3. Si la petición NO es una carpeta o directorio existente (!-d)
    RewriteCond %{REQUEST_FILENAME} !-d

    # 4. Redirigir todas las demás peticiones a index.php
    RewriteRule ^ index.php [QSA,L]